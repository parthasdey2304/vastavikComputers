rules_version = '2';

// Recommended Firestore Security Rules for Vastavik Computers.
// Deploy with:  firebase deploy --only firestore:rules
// (copy this file over firestore.rules, or merge into your existing rules)

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: true when the signed-in user has role == 'admin' in their profile
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---------------- Users ----------------
    match /users/{userId} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if (request.auth != null && request.auth.uid == userId)
                       || isAdmin();
      allow delete: if isAdmin();

      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /ai_chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ---------------- Transactions ----------------
    match /transactions/{txId} {
      allow get, list: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow write: if request.auth != null; // tighten in Phase 2 with validation
    }

    // ---------------- Courses (read by all signed-in; write only admin) ----------------
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /parts/{partId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();

        match /subparts/{subpartId} {
          allow read: if request.auth != null;
          allow write: if isAdmin();

          match /lessons/{lessonId} {
            allow read: if request.auth != null;
            allow write: if isAdmin();
          }
        }
      }
    }

    // ---------------- Question Papers / PYQs ----------------
    match /questionPapers/{paperId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }

      // PDF attachments: files live in Firebase Storage; only URLs here.
      match /attachments/{attachmentId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // ---------------- Banners ----------------
    match /banners/{bannerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------------- Popular Topics (home screen) ----------------
    match /popularTopics/{topicId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------------- Student Course Selection ----------------
    match /studentSelections/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---------------- Subscriptions (UPI mandates) ----------------
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if (request.auth != null && request.auth.uid == resource.data.uid) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
